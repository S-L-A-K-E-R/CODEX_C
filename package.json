{
  "name": "codex-c",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-notices.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:curriculum": "node --experimental-strip-types scripts/verify-curriculum.ts",
    "test:runtime": "node --experimental-strip-types scripts/verify-runtime.ts",
    "format": "prettier --write src scripts tests docs *.md *.json *.ts index.html .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests docs *.md *.json *.ts index.html .github/workflows/*.yml"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@runno/wasi": "0.10.3",
    "fflate": "0.8.3",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
