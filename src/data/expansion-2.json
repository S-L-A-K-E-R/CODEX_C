    "title": "Clamp with a function",
    "kind": "core",
    "brief": "Implement int clamp(int x,int lo,int hi) that restricts an integer to the inclusive interval [lo,hi].",
    "input": "Three integers x lo hi in [-100,100], lo <= hi.",
    "output": "clamped=N.",
    "tests": [
      {
        "label": "Example",
        "input": "15 0 10\n",
        "output": "clamped=10\n"
      },
      {
        "label": "Case 2",
        "input": "-5 -2 7\n",
        "output": "clamped=-2\n"
      },
      {
        "label": "Case 3",
        "input": "4 0 10\n",
        "output": "clamped=4\n"
      },
      {
        "label": "Case 4",
        "input": "5 5 5\n",
        "output": "clamped=5\n"
      }
    ],
    "starter": {
      "main.c": "#include <stdio.h>\n\nint main(void) {\n    // TODO: Clamp with a function\n    return 0;\n}\n"
    },
    "hints": [
